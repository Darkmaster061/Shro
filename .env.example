# آدرس عمومی سامانه (برای ساخت لینک‌ها و متاتگ‌ها)
APP_URL="http://localhost:3000"

# پورت اجرای سرور (پیش‌فرض ۳۰۰۰)
PORT="3000"

# کلید محرمانه برای هش تاریخ تولد دانشجویان (HMAC-SHA256 Pepper) — در محیط واقعی حتماً رشته تصادفی ۶۴ کاراکتری بگذارید
COUPON_PEPPER="change-this-to-a-long-random-64-char-secret-in-production"

# کلید امضای کوکی نشست ادمین — در محیط واقعی حتماً تغییر دهید
SESSION_SECRET="change-this-to-another-long-random-secret-in-production"

# مسیر فایل دیتابیس SQLite
DATABASE_PATH="./data/portal.db"

# مسیر ذخیره فایل‌های آپلودی (لوگو، PDF، تصاویر)
UPLOADS_DIR="./uploads"

# اطلاعات کاربر مالک اولیه (برای اسکریپت npm run create-admin)
ADMIN_USERNAME="owner"
ADMIN_PASSWORD="ChangeMe!2026"

# حذف خودکار لیست دانشجویان چند روز پس از پایان ثبت‌نام (۰ = غیرفعال)
AUTO_PURGE_DAYS="0"

